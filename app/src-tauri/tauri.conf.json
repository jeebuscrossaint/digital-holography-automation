{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Holography",
  "version": "0.1.0",
  "identifier": "edu.ucf.creol.holography",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Digital Holography",
        "width": 1400,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Digital holography control",
    "longDescription": "Hardware control + experiment automation for UCF CREOL photonic-lantern digital holography setup.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/holography-sidecar"
    ],
    "resources": [
      "../../vendor/**/*"
    ]
  }
}
